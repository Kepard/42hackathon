# Copy to .env. Never commit real credentials.
HOLOSPEED_MODE=demo
GAMEPLAY_MODE=state
RUN_GOAL=nether
HOLOSPEED_HOST=127.0.0.1
HOLOSPEED_PORT=8765
HOLOSPEED_RUNS_DIR=runs
MINECRAFT_SEED=-1950884254474434485
# Generated by: holospeed init-bridge --minecraft-dir /path/to/minecraft
HOLOSPEED_BRIDGE_TOKEN=

HCOMPANY_API_KEY=
HOLO_MODEL=holo4-35b-a3b
HOLO_REASONING_EFFORT=none
HOLO_COMPACT=true
HOLO_BASE_URL=https://api.hcompany.ai/v1

JEV_API_KEY=
JEV_MODEL=jev-1.14.0
JEV_BASE_URL=https://api.typesafe.ai

DEVIN_API_KEY=
DEVIN_ORG_ID=
MODEL_TIMEOUT_SECONDS=30
VALIDATE_HOLO_PLANS=true
ALLOW_EXPLORATION=true
MAX_ACTIONS=300
MAX_RUN_SECONDS=1800
# Optional hosted read-only observer publisher. Keep both tokens private.
HOLOSPEED_SITE_TOKEN=
HOLOSPEED_INGEST_TOKEN=
# Gladia is deliberately deferred.
